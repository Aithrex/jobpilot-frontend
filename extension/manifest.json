{
  "manifest_version": 3,
  "name": "JobPilot — Apply Assistant",
  "version": "0.2.0",
  "description": "High-signal application autofill + résumé-grounded answers. You review, you submit — never spray-and-pray.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://*.myworkdayjobs.com/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://*.icims.com/*",
    "https://*.ashbyhq.com/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.smartrecruiters.com/*",
    "https://apply.workable.com/*",
    "https://*.workable.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobPilot Apply Assistant"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://*.myworkdayjobs.com/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.icims.com/*",
        "https://*.ashbyhq.com/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.smartrecruiters.com/*",
        "https://apply.workable.com/*",
        "https://*.workable.com/*"
      ],
      "js": [
        "config.js",
        "lib/redact.js",
        "lib/ratelimit.js",
        "adapters/greenhouse.js",
        "adapters/lever.js",
        "adapters/ashby.js",
        "adapters/workday.js",
        "adapters/workable.js",
        "adapters/smartrecruiters.js",
        "adapters/generic.js",
        "adapters/index.js",
        "lib/resolver.js",
        "lib/reviewcard.js",
        "lib/autosubmit.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["config.js", "tokensync.js"],
      "run_at": "document_idle"
    }
  ]
}
